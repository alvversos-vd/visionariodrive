<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. AppCompat DayNight: BridgeActivity herda de
         AppCompatActivity e EXIGE um tema Theme.AppCompat (ou descendente). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Tema de launch: AppCompat + fundo AMOLED do splash.
         NÃO usar parent="Theme.SplashScreen" aqui: esse tema não descende de
         Theme.AppCompat e o @capacitor/splash-screen (que trocaria o tema via
         installSplashScreen) não está instalado neste projeto. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
